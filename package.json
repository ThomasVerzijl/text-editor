{
  "name": "text-editor-desktop",
  "private": true,
  "version": "0.0.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "npm --prefix text-editor run dev -- --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron .",
    "build": "npm run build:renderer && electron-builder",
    "build:renderer": "npm --prefix text-editor run build"
  },
  "build": {
    "appId": "com.thomasverzijl.text-editor",
    "files": [
      "electron/**/*",
      "text-editor/dist/**/*"
    ],
    "directories": {
      "output": "release"
    }
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "wait-on": "^9.5.1"
  }
}
